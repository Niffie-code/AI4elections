# Copy to .env (never commit .env). Generate a reviewer token with: python -m scripts.make_reviewer_token
NT_REVIEWER_TOKEN_HASHES=            # comma-separated sha256 hashes, NOT the tokens
NT_ALLOWED_ORIGINS=https://your-frontend.example
NT_STORAGE_DIR=/var/tmp/noticetrust_uploads
NT_TRUST_PROXY=0                     # 1 only behind exactly one trusted proxy
NT_ENABLE_DOCS=0
